// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum FoodOrderStatus {
  PENDING
  CANCELED
  DELIVERED
}

model User {
  id          String   @id @default(nanoid())
  email       String   @unique
  phoneNumber String?
  address     String?
  otp         String?
  otpTries    Int      @default(0)
  role        UserRole @default(USER)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  foodOrders FoodOrder[]
}

model FoodCategory {
  id           String   @id @default(nanoid())
  categoryName String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  foods Food[]
}

model Food {
  id          String   @id @default(nanoid())
  foodName    String
  price       Float
  image       String
  ingredients String
  categoryId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  category       FoodCategory    @relation(fields: [categoryId], references: [id])
  foodOrderItems FoodOrderItem[]
}

model FoodOrder {
  id         String          @id @default(nanoid())
  userId     String
  totalPrice Float
  status     FoodOrderStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  user           User            @relation(fields: [userId], references: [id])
  foodOrderItems FoodOrderItem[]
}

// Embedded in FoodOrder on MongoDB; separate table for PostgreSQL/Prisma
model FoodOrderItem {
  id          String @id @default(nanoid())
  foodOrderId String
  foodId      String
  quantity    Int

  foodOrder FoodOrder @relation(fields: [foodOrderId], references: [id], onDelete: Cascade)
  food      Food      @relation(fields: [foodId], references: [id])
}
